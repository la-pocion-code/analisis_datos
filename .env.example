# ============================================================================
# .env.example — SOLO NOMBRES DE VARIABLES. Ni un valor, nunca.
#
# Copiar a `.env` y rellenar. `.env` y `.env.*` estan en `.gitignore`; este
# fichero es la unica excepcion (`!.env.example`).
#
# ⚠ Esta lista se genero el 2026-08-12 leyendo los `os.getenv()` REALES del
#   codigo (excluyendo `virtual-env/`, que esta commiteado por error). Si anades
#   una variable al codigo, anadela aqui en el mismo cambio o esto empieza a
#   mentir — que es como el repo de la intranet perdio una tarde.
#
# ⚠⚠ En Railway estas variables se ponen en el servicio de `analisis_datos`, NO
#    en el de la intranet: el `.env` de la intranet no tiene ni una linea que lea
#    ninguna de estas, y ponerlas ahi solo cambia el texto del log.
# ============================================================================


# ── PostgreSQL: el almacen (escritura) ───────────────────────────────────────
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── PostgreSQL: replica/rol de solo lectura, si se usa ───────────────────────
RO_DB_HOST=
RO_DB_PORT=
RO_DB_NAME=
RO_DB_USER=
RO_DB_PASSWORD=

# ── Odoo (XML-RPC) — ⚠ en minusculas, asi las lee el codigo ──────────────────
url=
db=
username_odoo=
password=

# ── Correo de los informes ───────────────────────────────────────────────────
SENDER_EMAIL=
SENDER_PASSWORD=

# ── Google Drive (service account) ───────────────────────────────────────────
# Ruta al JSON en disco, no el JSON.
GOOGLE_CREDENTIALS_PATH=

# ── API de reportes ──────────────────────────────────────────────────────────
REPORTES_API_KEY=


# ════════════════════════════════════════════════════════════════════════════
# HOJA DE MARKETING de la intranet (`cargar_marketing.py`)
# El contrato completo esta en el otro repo:
#   intranet/docs/dashboards/marketing-contrato.md
# ════════════════════════════════════════════════════════════════════════════

# ── Gasto publicitario: Meta, Google Ads y TikTok via Supermetrics ───────────
# ⚠ Clave de plan **Enterprise**: con otra responde 401/403.
SUPERMETRICS_API_KEY=
SUPERMETRICS_TEAM_ID=

# ── Venta web: Shopify Admin API (una tienda por pais) ───────────────────────
# ⚠⚠ UN PAR POR PAIS, y el sufijo es el CODIGO DEL CATALOGO
#    (`marts.bi_marketing_pais.pais`), que NO siempre es ISO: Rep. Dominicana es
#    `RD` aqui y `DO` en ISO. Si el sufijo no coincide con el catalogo, el loader
#    da esa tienda por «sin credencial».
#
# ⚠⚠ Shopify NO emite un token que sirva para varias tiendas, ni dentro de la
#    misma organizacion: son 6 apps y 6 tokens, uno por tienda.
#
# ⚠⚠ FALTAR UNA ABORTA LA CARGA A PROPOSITO. Cargar 5 de 6 tiendas y publicarlo
#    como el total es un numero creible y falso. Para dar de alta un pais antes
#    de tener su token, sembrarlo con `activo = FALSE` en el catalogo.
#
# `SHOPIFY_SHOP_*` es el dominio `*.myshopify.com` (con o sin `https://`).
# ⚠ NO es el GID: `bi_marketing_pais.shopify_shop` guarda el GID, que sirve para
#   cotejar la identidad de la tienda pero no para construir la URL de la API.
SHOPIFY_SHOP_CO=
SHOPIFY_TOKEN_CO=
SHOPIFY_SHOP_EC=
SHOPIFY_TOKEN_EC=
SHOPIFY_SHOP_RD=
SHOPIFY_TOKEN_RD=
# Los tres paises nuevos: anadir su par con el codigo que se les de en el
# catalogo, y su fila en `bi_marketing_pais` en el mismo cambio.
# SHOPIFY_SHOP_XX=
# SHOPIFY_TOKEN_XX=

# ── Trafico: GA4 y Search Console (conectores SIN IMPLEMENTAR) ───────────────
# El JSON entero del service account, no una ruta.
# ⚠ Los IDs de propiedad y las URL de sitio NO son variables: viven en
#   `marts.bi_marketing_pais` (`ga4_property_id`, `gsc_site_url`).
GA4_CREDENTIALS_JSON=
GSC_CREDENTIALS_JSON=

# ── La TRM no necesita credencial (serie publica de datos.gov.co) ────────────

# ⚠ `META_ACCESS_TOKEN` esta en algunos `.env` y **el codigo no lo lee**: hoy
#   Meta entra por Supermetrics. Hara falta si se implementa la Marketing API
#   directa (marketing-contrato.md §1b), y hasta entonces no hace nada.
